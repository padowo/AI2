{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d')|raw }}",
            "celsius": {{ m.celsius|raw }},
            "fahrenheit": {{ m.fahrenheit|raw }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
